PORT=8080
HOST=0.0.0.0
POSTGRES_URL=postgres://agent_gateway:agent_gateway@localhost:5432/agent_gateway
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=otel
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
PROJECTION_INTERVAL_MS=5000
STALE_AFTER_SECONDS=120

# Authentication
AUTH_ENABLED=true
# Bootstrap API user. The row is upserted on every startup. CHANGE THESE.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Gateway-hosted agent execution (remote control)
# The gateway runs Claude Code in-process via the Agent SDK. It does NOT manage
# credentials — the API key/login below is inherited by the hosted process.
AGENT_ENABLED=true
AGENT_WORKSPACE=/workspace
# Collector endpoint injected into hosted runs so their telemetry shows up in the
# session list. Inside compose this is the collector service name.
AGENT_OTEL_ENDPOINT=http://otel-collector:4317
# Non-interactive runs; bypass permission prompts. Use default/acceptEdits to be stricter.
AGENT_PERMISSION_MODE=bypassPermissions
# Optional model override for hosted runs.
AGENT_MODEL=

# --- Credentials for hosted runs ---
# 选项 A(推荐):Amazon Bedrock,用一个长期 IAM 用户的静态 key。
# 把你为 Bedrock 创建的 IAM 用户的 access key / secret 填在下面两行即可。
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 仅当使用临时/STS 凭证时才需要;长期 key 请留空。
AWS_SESSION_TOKEN=

# 选项 B:直接用 Anthropic API(用此项时请把上面 Bedrock 部分留空)。
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
